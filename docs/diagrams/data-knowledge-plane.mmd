    POSTGRES --> QUERY["Bounded query service"]
    PROJECTION --> QUERY
    QDRANT --> QUERY
    QUERY --> HARNESS["Agent harnesses\nadvisory"]
    HARNESS --> PROPOSAL["Evidence / knowledge proposal"]
    PROPOSAL --> GATE["ChaseOS quarantine + promotion Gate"]
