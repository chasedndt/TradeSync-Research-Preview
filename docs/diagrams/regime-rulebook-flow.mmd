    BLOCKS --> WEIGHT
    QUALITY --> WEIGHT
    RISK["Independent risk flags"] --> CAPS["Minimum paper-risk cap wins"]
    CONFIG --> CAPS
    WEIGHT --> PLAYBOOK["Named playbook suitability"]
    CAPS --> PLAYBOOK
    PLAYBOOK --> EVENT["PostgreSQL replay record"]
    EVENT --> STREAM["Redis paper-shadow event"]
    EVENT --> LAB["Regime Lab comparison - planned"]
    CHASE["ChaseOS or model context - optional"] -. "advisory only" .-> RISK
