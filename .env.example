# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Postgres ---
POSTGRES_USER=tradesync
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_DB=tradesync
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Qdrant ---
QDRANT_PORT=6333

# --- Service Ports ---
STATE_API_PORT=8000
INGEST_PORT=8080
FUSION_ENGINE_PORT=8002
HL_EXEC_PORT=8004

# --- Mobile notifications (docs/runbooks/MOBILE_ALERTS.md) ---
# Real values belong only in the private runtime.env, set through tools\set-runtime-secret.ps1.
# 32+ random characters; authorizes the mobile controls. Not a wallet key and grants no trading.
MOBILE_ALERTS_CONTROL_KEY=
# Web Push (VAPID) key pair, generated on the operator's PC with the runbook command; never committed.
# The public key is served to browsers. The private key signs pushes and is never returned, logged or displayed.
MOBILE_WEB_PUSH_VAPID_PUBLIC_KEY=
MOBILE_WEB_PUSH_VAPID_PRIVATE_KEY=
# The sender's contact for push services: a mailto: address or an https: URL. Required to send (Apple's push
# service refuses a push without one); until it is set, alerts keep going through ntfy. Never returned by a route.
MOBILE_WEB_PUSH_SUBJECT=

# --- Execution (Phase 3E - leave blank until wallet integration is complete) ---
HYPERLIQUID_WALLET_PK=
DRY_RUN=true
EXECUTION_ENABLED=false

# --- Phase 3C: Market Microstructure & Risk Guardian ---
MAX_SPREAD_BPS=50.0
OPTIMAL_SPREAD_BPS=2.0
MIN_DEPTH_25BP_USD=100000
MAX_IMPACT_BPS_5K=25.0
MIN_LIQUIDITY_SCORE=0.3
MARGIN_STRESS_THRESHOLD=0.8
MAX_EXPOSURE_PER_SYMBOL_USD=25000

# --- Phase 3C: Macro Feed ---
MACRO_FEED_CACHE_TTL=300
MACRO_RSS_SOURCES='[{"name": "Cointelegraph", "url": "https://cointelegraph.com/rss/tag/bitcoin", "category": "crypto"}, {"name": "CoinDesk", "url": "https://www.coindesk.com/arc/outboundfeeds/rss/", "category": "crypto"}]'

# --- Free context-only enrichment feeds ---
# These providers enrich the dashboard and never authorize scoring or execution.
COINGECKO_CONTEXT_ENABLED=true
COINGECKO_CONTEXT_TTL_SECONDS=300
DEFILLAMA_CONTEXT_ENABLED=true
DEFILLAMA_CONTEXT_TTL_SECONDS=900
FRED_CONTEXT_ENABLED=false
FRED_API_KEY=
FRED_SERIES=DFF,DTWEXBGS
FRED_CONTEXT_TTL_SECONDS=3600
CONTEXT_FEED_TIMEOUT_SECONDS=6
